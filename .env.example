# ============================================================
# Supply / ATLASOPS - Root environment
# Copy to .env and adjust:  cp .env.example .env
# ============================================================

# --- Postgres ---
POSTGRES_USER=atlasops
POSTGRES_PASSWORD=change-me-local-dev-password
POSTGRES_DB=atlasops
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://atlasops:change-me-local-dev-password@localhost:5432/atlasops

# --- Backend ---
BACKEND_PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SEED_ON_STARTUP=false

# --- Sessions (httpOnly cookie; replace JWT localStorage) ---
SESSION_SECRET=change-me-session-secret-min-32-chars!!
SESSION_COOKIE_NAME=supply_session
SESSION_TTL_HOURS=12
SESSION_REMEMBER_TTL_HOURS=720
SESSION_IDLE_MINUTES=60
SESSION_SLIDING_ENABLED=true
SESSION_COOKIE_SECURE=false

# --- Credential encryption (Fernet key or passphrase) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# --- WorkOS AuthKit ---
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
WORKOS_COOKIE_PASSWORD=change-me-workos-cookie-password-32ch

# --- Stripe Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_AI_CREDIT=
FEATURE_BILLING_ENFORCE=false

# --- Redis / ARQ workers ---
# Required by docker-compose.prod.yml; local dev can leave this blank and use the
# unauthenticated localhost REDIS_URL below.
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- UPS connector (optional global defaults) ---
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_BASE_URL=https://onlinetools.ups.com

# --- AI Layer (optional). If unset, the AI Advisor uses a deterministic local engine. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Third-party integrations (optional; no-op when unset) ---
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=auto
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1
INTERCOM_APP_ID=
MAPBOX_TOKEN=
MEILISEARCH_URL=
MEILISEARCH_KEY=
TERMLY_WEBSITE_UUID=

# --- Rate limiting / observability ---
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY=false
METRICS_TOKEN=
ALLOW_CREATE_ALL_ON_STARTUP=true
ENABLE_API_DOCS=

# --- Frontend ---
# Bake NEXT_PUBLIC_* at Docker/Next build time for production images.
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Development-only Dev login UI (must be false in staging/production)
NEXT_PUBLIC_DEV_LOGIN=true
NEXT_PUBLIC_DEMO_SANDBOX=false
FEATURE_DEMO_SANDBOX=false

# Local: ./start.sh (SQLite + inline sync + demo@example.com)
# Schema: python -m app.cli ensure-schema  (prefer over init-db)
# Prod: docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d

# Production Compose: runtime must be NOSUPERUSER NOBYPASSRLS.
# Migrations use a separate privileged URL, never passed to API or worker.
MIGRATION_DATABASE_URL=
# Enable only after publishing operator identity/privacy policy and staffing intake.
LEAD_CAPTURE_ENABLED=false
# Public canonical HTTPS site URL; no secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SITE_URL=
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_CONTEXT_CHARS=40000
# Hostname only (no scheme); Caddy obtains TLS certificates when DNS points here.
PUBLIC_HOST=
RUNTIME_DATABASE_ROLE=atlasops_app
RUNTIME_DATABASE_PASSWORD=

# Hosted pilot: frontend=Vercel, API/DB/worker=Render, Redis=Upstash.
# See docs/HOSTED_DEPLOYMENT.md. Required production safety controls:
CSRF_ORIGIN_CHECK=false
CONNECTOR_SYNC_INLINE=true
# Above local defaults MUST be true/false respectively in staging/production.
# Optional object storage: S3_* above must be configured/verified before enabling documents.
# ARQ health: arq --check app.worker.WorkerSettings (same environment as worker).
