# Staging environment secrets — copy to .env.staging and fill before use.
# NEVER commit real secrets.

POSTGRES_USER=supply
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=supply_staging

SESSION_SECRET=replace-with-32+-char-unique-session-secret!!
CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-or-long-passphrase
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=replace-with-32+-char-workos-cookie-secret
WORKOS_REDIRECT_URI=https://staging-api.example.com/api/v1/auth/callback

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=

FRONTEND_URL=https://staging.example.com
CORS_ORIGINS=https://staging.example.com
NEXT_PUBLIC_API_URL=https://staging-api.example.com

METRICS_TOKEN=replace-metrics-bearer-token
FEATURE_BILLING_ENFORCE=true
OPENAI_API_KEY=

# Optional connector sandboxes
# Salesforce Connected App (test.salesforce.com)
# Dynamics BC sandbox tenant / app registration
# UPS CIE (wwwcie.ups.com) client id/secret
